<?xml version="1.0"?>
<robot name="handycar">

    <material name="blue">
        <color rgba="0 0 1 1" />
    </material>
    <material name="orange">
        <color rgba="1.0 0.549 0.0 1.0" />
    </material>
    <material name="yellow">
        <color rgba="1 1 0 1" />
    </material>
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.8 0.6 0.4" />
            </geometry>
            <origin xyz="0 0 0.2" rpy="0 0 0" />
            <material name="blue">
                <color rgba="0 0 1 1" />
            </material>
        </visual>
    </link>

    <link name="front_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.075" length="0.09" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1" />
            </material>
        </visual>
    </link>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.15" length="0.09" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1" />
            </material>
        </visual>
    </link>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.15" length="0.09" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1" />
            </material>
        </visual>
    </link>

    <link name="hand_stand">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.03" />
            </geometry>
            <origin xyz="0 0 0.015" rpy="0 0 0" />
            <material name="orange">
                <color rgba="0.36 0.25 0.20 1" />
            </material>
        </visual>
    </link>
    
    <link name="first_hand">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.4"/>
            </geometry>
            <origin xyz="0 0 0.2" rpy="0 0 0" />
            <material name="yellow">
                <color rgba="1 1 0 1" />
            </material>
        </visual>
    </link>

    <link name="second_hand">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.4"/>
            </geometry>
            <origin xyz="0 0 0.2" rpy="0 0 0" />
            <material name="orange">
                <color rgba="0.36 0.25 0.20 1" />
            </material>
        </visual>
    </link>


    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.15" rpy="0 0 0" />
    </joint>

    <joint name="base_front_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="front_wheel" />
        <origin xyz="0.3 0 -0.075" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel" />
        <origin xyz="-0.15 0.345 0.0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel" />
        <origin xyz="-0.15 -0.345 0.0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_stand_joint" type="fixed">
        <parent link="base_link" />
        <child link="hand_stand" />
        <origin xyz="0.2 0 0.4" rpy="0 0 0" />
    </joint>

     <joint name="stand_fhand_joint" type="revolute">
        <parent link="hand_stand" />
        <child link="first_hand" />
        <origin xyz="0 0 0.03" rpy="0 0 0" />
        <limit lower="0" upper="1.571" effort="10" velocity="3" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="stand_shand_joint" type="revolute">
        <parent link="first_hand" />
        <child link="second_hand" />
        <origin xyz="0 0 0.4" rpy="0 0 0" />
        <limit lower="0" upper="1.571" effort="10" velocity="3" />
        <axis xyz="0 1 0" />
    </joint>

</robot>